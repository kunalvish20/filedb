{
  "compilerOptions": {
    "target": "ES2020",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "app.config.js"
  ]
}
