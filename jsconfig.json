{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "checkJs": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "electron/**/*.js",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "tests/**/*.js",
    "next.config.mjs",
    "vitest.config.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "electron-dist",
    "standalone",
    "packages"
  ]
}
